        "validator_family": "astra"
      },
      "expect": true
    },
    {
      "id": "fable-opus-downgrade-m2",
      "note": "m2: Fable reviewing Opus is a declared same-lab downgrade, never compliant",
      "fn": "rule2_review",
      "args": {
        "producer_family": "opus",
        "reviewer_family": "fable"
      },
      "expect": {
        "compliant": false,
        "same_lab_downgrade": true
      }
    },
    {
      "id": "opus-astra-review-compliant",
      "fn": "rule2_review",
      "args": {
        "producer_family": "opus",
        "reviewer_family": "astra"
      },
      "expect": {
        "compliant": true,
        "same_lab_downgrade": false
      }
