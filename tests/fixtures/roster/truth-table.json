{
  "version": 1,
  "note": "Consumed by `scripts/roster/generate.py --self-test`. Each case calls one pure rule function by name with `args` and compares the JSON-normalized result to `expect`. Coverage follows PLAN-M1-r5.md §P1 Tests.",
  "cases": [
    {
      "id": "opus-cross-version-5.5-producer-5-reviewer",
      "note": "Opus 5.5 as producer, Opus 5 as reviewer -- refused (A2)",
      "fn": "chain_refusal",
      "args": {
        "family_a": "opus",
        "exact_a": "claude-opus-5-5",
        "family_b": "opus",
        "exact_b": "claude-opus-5"
      },
      "expect": true
    },
    {
      "id": "opus-cross-version-5-producer-5.5-reviewer",
      "note": "Opus 5.5 as reviewer of Opus 5 -- refused, other direction (A2)",
      "fn": "chain_refusal",
      "args": {
        "family_a": "opus",
        "exact_a": "claude-opus-5",
        "family_b": "opus",
        "exact_b": "claude-opus-5-5"
      },
      "expect": true
    },
    {
      "id": "sol-sol-refused",
      "fn": "rule1_validate",
      "args": {
        "producer_family": "sol",
        "validator_family": "sol"
      },
      "expect": false
    },
    {
      "id": "kimi-sol-refused-m1",
      "note": "m1: current chain lets Kimi validate Sol work; lint reports it as an existing conflict",
      "fn": "rule1_validate",
      "args": {
        "producer_family": "sol",
        "validator_family": "kimi"
      },
      "expect": false
