    {
      "id": "luna-substring-near-miss-not-matched",
      "note": "sao10k-l3-lunaris-8b must never match a 'luna' lookup by substring; slug matching is exact-field only",
      "fn": "slug_row_matches",
      "args": {
        "row": {
          "model": "sao10k-l3-lunaris-8b",
          "effort": "high",
          "reasoning_mode": "reasoning"
        },
        "want_model": "luna",
        "want_effort": "high"
      },
      "expect": false
    },
    {
      "id": "relay-rejects-opus",
      "note": "coordination-sonnet rejects Opus 5.5 -- relay seat, not an authority/judgment role",
      "fn": "rule6_relay",
      "args": {
        "role": "coordination",
        "candidate_family": "opus"
      },
      "expect": {
        "refused": true
      }
    },
    {
      "id": "relay-rejects-astra",
      "fn": "rule6_relay",
