{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subreason",
    "fallback_reason",
    "label",
    "confidence",
    "probabilities",
    "abstain_below",
    "run_ref",
    "case_ref",
    "claim_sha256",
    "label_descriptions_sha256",
    "revision",
    "project_root_sha256",
    "request_sha256",
    "model_returned_matches",
    "model_returned_sha256",
    "persist_error_class",
    "schema",
    "schema_version",
    "adapter_version",
    "wire_schema",
    "decision_id",
    "started_at",
    "ended_at",
    "outcome",
    "section_sha256s",
    "model_requested",
    "rule_ids",
    "effective_mode",
    "active_denied",
    "application",
    "advisory",
    "use",
    "persisted",
    "flag_value_unknown",
    "attempt_records",
    "jev_usage_accounting",
    "attempts"
