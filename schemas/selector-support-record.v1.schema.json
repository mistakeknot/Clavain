          "cred.cookie",
          "cred.url_userinfo",
          "cred.loaded_key",
          "cred.high_entropy",
          "src.provenance_unavailable",
          "src.path_invalid",
          "src.outside_project",
          "src.symlink",
          "src.denylisted_path",
          "src.not_at_revision",
          "src.target_changed",
          "proj.unowned",
          "size.over_limit"
